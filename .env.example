# ─────────────────────────────────────────────────────────────
# Sukoon environment variables
# Copy to .env.local. Every variable is optional: with none set,
# Sukoon runs in Local Mode (data stays in this browser only).
# ─────────────────────────────────────────────────────────────

# Supabase (enables accounts + cloud sync). Public by design —
# access is enforced by Row Level Security, not by hiding these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude (enables the AI reflection companion). SERVER-ONLY.
# Never prefix with NEXT_PUBLIC_. Without it, the companion uses
# an on-device guide that never sends text anywhere.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=
